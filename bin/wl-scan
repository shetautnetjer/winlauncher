#!/usr/bin/env python3
"""wl-scan — read-only inventory of a game library: engine, bitness, launcher and
translation status for every game folder.

  wl-scan [LIBRARY]            # default $WL_LIBRARY or ~/Games; prints the table
  wl-scan [LIBRARY] --write    # also writes status/STATUS.md (generic ids only) and
                               # status/library-map.tsv (id -> real folder, local only)
  wl-scan [LIBRARY] --json

It never writes into the library. Game ids are the winrun prefix ids, so
`winrun --id <id>` and ~/.local/state/winlauncher/games/<id>/ line up with this table.
"""
import argparse
import json
import os
import sys
import time
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(ROOT / "lib"))
import wlcommon as wl  # noqa: E402

# Top-level folders that are not games: "Archives", anything starting with "_" or ".",
# plus any names listed in WL_SCAN_SKIP (colon-separated).
SKIP_TOP = {"Archives"} | {n for n in os.environ.get("WL_SCAN_SKIP", "").split(":") if n}

LAYER = {  # what kind of English each engine can get
    "Unity Mono": "A: wl-translate (automated)",
    "Unity IL2CPP": "A: BepInEx 6 IL2CPP (staged packages)",
    "Godot": "B: unpack .pck, translate, repack",
    "RPG Maker MV": "B: edit data/*.json",
    "RPG Maker MZ": "B: edit data/*.json",
    "Electron": "B: unpack app.asar",
    "NW.js": "B: unpack package.nw / nw.pak",
    "Flash projector": "B: FFDec text replace (Java CLI)",
    "WolfRPG": "B: WolfTL dump/patch",
    "packed (Enigma Virtual Box)": "unpack first",
}


def scan_folder(top: Path):
    rows = []
    exe = wl.pick_main_exe(top)
    if exe is None:
        return [{"folder": top.name, "engine": "no .exe found", "arch": "", "exe": "", "id": "",
                 "launcher": "-", "translation": "-", "layer": "-", "detail": ""}]
    eng = wl.detect_engine(exe)
    info = wl.pe_info(exe) or {}
    ls = wl.launcher_state(exe.parent)
    ts = wl.translation_state(exe.parent)
    if ls["last"]:
        rc, secs = ls["last"]["rc"], ls["last"]["secs"]
        ok = rc == "0" or (secs.isdigit() and int(secs) >= 20)
        launcher = f"{'ran' if ok else 'FAILED'} (rc {rc}, {secs}s, {ls['last']['when'][:10]})"
    else:
        launcher = "prefix ready, not run" if ls["prefix"] else "not run yet"
    if ts["xunity"]:
        ep = ts["endpoint"] or "default (unconfigured!)"
        translation = f"XUnity on BepInEx {ts['bepinex']}, endpoint {ep}, {ts['lines']} lines cached"
        if ts["endpoint"] and ts["endpoint"] != "CustomTranslate":
            translation += "  ← NOT local"
    elif ts["bepinex"]:
        translation = f"BepInEx {ts['bepinex']} present, no XUnity"
    else:
        translation = "none"
    key = next((k for k in LAYER if eng["engine"].startswith(k)), None)
    rows.append({"folder": top.name, "id": ls["id"], "exe": str(exe.relative_to(top)),
                 "arch": info.get("arch", "?"), "engine": eng["engine"], "detail": eng.get("detail", ""),
                 "launcher": launcher, "translation": translation,
                 "layer": LAYER.get(key, "-") if key else "-"})
    return rows


def main():
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("library", nargs="?",
                    default=os.environ.get("WL_LIBRARY", str(Path.home() / "Games")))
    ap.add_argument("--write", action="store_true")
    ap.add_argument("--json", action="store_true")
    a = ap.parse_args()
    lib = Path(a.library).expanduser().resolve()
    rows = []
    for top in sorted(p for p in lib.iterdir() if p.is_dir() and p.name not in SKIP_TOP
                      and not p.name.startswith((".", "_"))):
        try:
            rows += scan_folder(top)
        except (OSError, ValueError) as e:
            rows.append({"folder": top.name, "id": "", "exe": "", "arch": "", "engine": f"error: {e}",
                         "detail": "", "launcher": "-", "translation": "-", "layer": "-"})
    for n, r in enumerate(rows, 1):
        r["n"] = f"G{n:02d}"
    if a.json:
        print(json.dumps(rows, indent=2, ensure_ascii=False))
        return 0
    hdr = "| # | id | engine | detail | bits | launcher | translation | English route |"
    sep = "|---|---|---|---|---|---|---|---|"
    table = [hdr, sep] + [
        f"| {r['n']} | `{r['id'][:8]}` | {r['engine']} | {r['detail']} | {r['arch']} | "
        f"{r['launcher']} | {r['translation']} | {r['layer']} |" for r in rows]
    print("\n".join(table))
    if a.write:
        out = ROOT / "status"
        out.mkdir(exist_ok=True)
        (out / "STATUS.md").write_text(
            f"# Library status\n\nGenerated by `wl-scan --write` on {time.strftime('%Y-%m-%d %H:%M')}.\n"
            "Titles are listed by number and prefix id only; `library-map.tsv` (local, not for "
            "sharing) maps them to folders.\n\n" + "\n".join(table) + "\n", encoding="utf-8")
        with open(out / "library-map.tsv", "w", encoding="utf-8") as f:
            f.write("n\tid\tfolder\texe\n")
            for r in rows:
                f.write(f"{r['n']}\t{r['id']}\t{r['folder']}\t{r['exe']}\n")
        print(f"\nwrote {out/'STATUS.md'} and {out/'library-map.tsv'}", file=sys.stderr)
    return 0


if __name__ == "__main__":
    sys.exit(main())
