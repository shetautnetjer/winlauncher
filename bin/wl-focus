#!/usr/bin/env python3
"""
wl-focus - give keyboard focus to a Wine window.

Under Wayland/mutter a Wine window can map and render while never becoming the
active window, so keystrokes (WASD, arrows) go to whatever else is focused and
the game looks unresponsive to input.

  wl-focus                 # focus the "Wine Desktop" window if there is one
  wl-focus risohiki        # focus the window whose class/title matches
  wl-focus 0x3600003       # focus an explicit window id

Uses X11 directly (XRaiseWindow + _NET_ACTIVE_WINDOW + XSetInputFocus), so it
needs only libX11 and xwininfo (package x11-utils), not xdotool/wmctrl.
Wine windows are X11 windows (XWayland on a Wayland desktop).

Exit codes: 0 focused, 1 no matching window yet, 3 cannot apply here
(no X display, xwininfo or libX11 missing). winrun retries only on 1.
"""
import ctypes
import os
import re
import shutil
import subprocess
import sys

NET_ACTIVE = "_NET_ACTIVE_WINDOW"
ClientMessage = 33
SubstructureRedirectMask = 1 << 20
SubstructureNotifyMask = 1 << 19


def tree():
    out = subprocess.run(["xwininfo", "-root", "-tree"], capture_output=True, text=True).stdout
    wins = []
    for line in out.splitlines():
        m = re.search(r'(0x[0-9a-f]+)\s+(.*?):\s+\((.*?)\)\s+(\d+)x(\d+)\+', line)
        if m:
            wid, name, cls, w, h = m.groups()
            wins.append({"id": wid, "name": name.strip('"'), "cls": cls, "w": int(w), "h": int(h)})
    return wins


def pick(arg, wins):
    if arg:
        if arg.startswith("0x"):
            return next((w for w in wins if w["id"] == arg), None)
        low = arg.lower()
        matches = [w for w in wins if low in w["cls"].lower() or low in w["name"].lower()]
        # prefer the largest matching window: helper windows are 1x1
        return max(matches, key=lambda w: w["w"] * w["h"]) if matches else None
    desk = [w for w in wins if "Wine Desktop" in w["name"]]
    if desk:
        return max(desk, key=lambda w: w["w"] * w["h"])
    wine = [w for w in wins if "explorer.exe" in w["cls"]]
    return max(wine, key=lambda w: w["w"] * w["h"]) if wine else None


def main():
    arg = sys.argv[1] if len(sys.argv) > 1 else ""
    if not os.environ.get("DISPLAY"):
        print("wl-focus: no X display (DISPLAY unset); skipping", file=sys.stderr)
        return 3
    if not shutil.which("xwininfo"):
        print("wl-focus: xwininfo not found (install x11-utils); skipping", file=sys.stderr)
        return 3
    wins = tree()
    target = pick(arg, wins)
    if not target:
        print(f"wl-focus: no window matching {arg!r}", file=sys.stderr)
        print("windows seen:", file=sys.stderr)
        for w in wins:
            if w["w"] > 200 and w["h"] > 200:
                print(f"  {w['id']}  {w['name'][:50]!r}  {w['cls']}", file=sys.stderr)
        return 1

    try:
        xlib = ctypes.CDLL("libX11.so.6")
    except OSError:
        print("wl-focus: libX11 not found; skipping", file=sys.stderr)
        return 3
    xlib.XOpenDisplay.restype = ctypes.c_void_p
    xlib.XInternAtom.restype = ctypes.c_ulong
    xlib.XDefaultRootWindow.restype = ctypes.c_ulong
    xlib.XDefaultRootWindow.argtypes = [ctypes.c_void_p]

    dpy = xlib.XOpenDisplay(None)
    if not dpy:
        print("wl-focus: cannot open display", file=sys.stderr)
        return 3
    root = xlib.XDefaultRootWindow(dpy)
    wid = int(target["id"], 16)

    # 1. ask the WM to keep it above everything, then raise it. A plain raise is
    #    not sticky under mutter: the next window that opens covers the game and
    #    swallows every click.
    atom_state = xlib.XInternAtom(ctypes.c_void_p(dpy), b"_NET_WM_STATE", False)
    atom_above = xlib.XInternAtom(ctypes.c_void_p(dpy), b"_NET_WM_STATE_ABOVE", False)
    atom_full = xlib.XInternAtom(ctypes.c_void_p(dpy), b"_NET_WM_STATE_FULLSCREEN", False)
    states = (ctypes.c_ulong * 2)(atom_above, atom_full)
    xlib.XChangeProperty(ctypes.c_void_p(dpy), ctypes.c_ulong(wid), ctypes.c_ulong(atom_state),
                         ctypes.c_ulong(4), 32, 0,                     # XA_ATOM, replace
                         states, 2)
    xlib.XRaiseWindow(ctypes.c_void_p(dpy), ctypes.c_ulong(wid))

    # 2. ask the window manager to activate it: some window managers only
    #    route keyboard focus to the _NET_ACTIVE_WINDOW they believe is current
    atom_active = xlib.XInternAtom(ctypes.c_void_p(dpy), NET_ACTIVE.encode(), False)
    atom_type = xlib.XInternAtom(ctypes.c_void_p(dpy), b"ATOM", False)

    class XClientMessageEvent(ctypes.Structure):
        _fields_ = [("type", ctypes.c_int), ("serial", ctypes.c_ulong),
                    ("send_event", ctypes.c_int), ("display", ctypes.c_void_p),
                    ("window", ctypes.c_ulong), ("message_type", ctypes.c_ulong),
                    ("format", ctypes.c_int), ("data", ctypes.c_long * 5)]

    class XEvent(ctypes.Union):
        _fields_ = [("xclient", XClientMessageEvent), ("pad", ctypes.c_long * 24)]

    ev = XEvent()
    ev.xclient.type = ClientMessage
    ev.xclient.send_event = 1
    ev.xclient.display = ctypes.c_void_p(dpy)
    ev.xclient.window = wid
    ev.xclient.message_type = atom_active
    ev.xclient.format = 32
    ev.xclient.data[0] = 2          # source: pager/tool
    ev.xclient.data[1] = 0          # timestamp
    ev.xclient.data[2] = 0          # current active window
    xlib.XSendEvent(ctypes.c_void_p(dpy), ctypes.c_ulong(root), False,
                    ctypes.c_long(SubstructureRedirectMask | SubstructureNotifyMask),
                    ctypes.byref(ev))

    # 3. and set focus directly, which works even when the WM ignores the hint
    xlib.XSetInputFocus(ctypes.c_void_p(dpy), ctypes.c_ulong(wid), 2, 0)  # RevertToParent, CurrentTime
    xlib.XFlush(ctypes.c_void_p(dpy))

    print(f"focused {target['id']}  {target['name'][:60]!r}  ({target['w']}x{target['h']})")
    return 0


if __name__ == "__main__":
    sys.exit(main())
